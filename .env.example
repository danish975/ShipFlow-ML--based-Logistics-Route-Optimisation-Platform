# ===========================================
# ShipFlow Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control

# Database
DATABASE_URL=postgresql://shipflow:shipflow_dev@localhost:5432/shipflow?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Backend
API_PORT=3002
API_URL=http://localhost:3002
NODE_ENV=development

# Google OAuth (create a Web application OAuth client in Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3002/api/v1/auth/google/callback
WEB_APP_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_WS_URL=http://localhost:3002
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Mapbox (Server-side)
MAPBOX_ACCESS_TOKEN=sk.your-mapbox-secret-token

# Google Maps (Optional - fallback)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=ml-service-api-key-change-this

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shipflow.dev

# Logging
LOG_LEVEL=debug

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
